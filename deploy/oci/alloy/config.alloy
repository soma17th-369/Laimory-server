// OCI prod host(단일 호스트: api·ai·nginx·mysql)의 경보용 지표를 Grafana Cloud(Free)로 보낸다.
// compose 서비스로 `laimory` 네트워크에 붙어 api·ai를 서비스 이름으로 찾는다(호스트 포트 publish 없음).
//
// 무료 한도(지표 10k active series) 안에 머물기 위해 경보 식이 쓰는 지표 이름만 내보낸다(아래 keep 규칙).
// 경보를 추가하면서 새 지표가 필요하면 keep 정규식에도 넣는다 — 넣지 않은 지표는 Cloud에 없다.
// 로그·trace 파이프라인은 두지 않는다(지표만, 개인정보 없음).

// ── 호스트: 메모리·디스크·OOM + textfile(MySQL 복제·백업 지표) ─────────────────────
prometheus.exporter.unix "host" {
  set_collectors = ["meminfo", "filesystem", "vmstat", "textfile"]
  procfs_path    = "/host/proc"
  sysfs_path     = "/host/sys"
  rootfs_path    = "/host/root"

  filesystem {
    fs_types_exclude     = "^(autofs|binfmt_misc|bpf|cgroup2?|configfs|debugfs|devpts|devtmpfs|efivarfs|fusectl|hugetlbfs|iso9660|mqueue|nsfs|overlay|proc|procfs|pstore|ramfs|rpc_pipefs|securityfs|selinuxfs|squashfs|sysfs|tmpfs|tracefs)$"
    mount_points_exclude = "^/(dev|proc|run|sys|var/lib/docker/.+)($|/)"
  }

  // 수집 스크립트(systemd timer)가 쓰는 디렉터리. 호스트 루트를 읽기 전용으로 마운트한 경로 아래에 있다.
  textfile {
    directory = "/host/root/var/lib/laimory/textfile"
  }
}

discovery.relabel "host" {
  targets = prometheus.exporter.unix.host.targets

  rule {
    target_label = "job"
    replacement  = "node"
  }
}

prometheus.scrape "host" {
  targets         = discovery.relabel.host.output
  scrape_interval = "60s"
  forward_to      = [prometheus.relabel.keep.receiver]
}

// ── api: Spring actuator(관리 포트 9090, 컨테이너 내부망에서만 열림) ─────────────────
prometheus.scrape "api" {
  targets         = [{"__address__" = "api:9090"}]
  job_name        = "spring_boot"
  metrics_path    = "/actuator/prometheus"
  scrape_interval = "60s"
  forward_to      = [prometheus.relabel.keep.receiver]
}

// ── ai: 지표 endpoint가 없어 /health 응답만 본다 ────────────────────────────────────
prometheus.exporter.blackbox "ai" {
  config = "{ modules: { http_2xx: { prober: http, timeout: 5s } } }"

  target {
    name    = "ai_health"
    address = "http://ai:8080/health"
    module  = "http_2xx"
  }
}

discovery.relabel "ai" {
  targets = prometheus.exporter.blackbox.ai.targets

  rule {
    target_label = "job"
    replacement  = "ai_health"
  }
}

prometheus.scrape "ai" {
  targets         = discovery.relabel.ai.output
  scrape_interval = "60s"
  forward_to      = [prometheus.relabel.keep.receiver]
}

// ── 내보낼 지표 고르기 ─────────────────────────────────────────────────────────────
prometheus.relabel "keep" {
  forward_to = [prometheus.remote_write.grafana_cloud.receiver]

  rule {
    source_labels = ["__name__"]
    regex         = "up|probe_success|laimory_oci_.+|node_memory_(MemAvailable|MemTotal)_bytes|node_filesystem_(avail|size)_bytes|node_vmstat_oom_kill|http_server_requests_seconds_(count|bucket)|jvm_memory_(used|max)_bytes|hikaricp_connections_(active|max|pending)"
    action        = "keep"
  }

  // label에 호스트 이름·IP·컨테이너 주소가 남지 않게 instance를 고정한다.
  rule {
    target_label = "instance"
    replacement  = "oci-prod"
  }
}

prometheus.remote_write "grafana_cloud" {
  // api 지표는 앱이 이미 environment="prod"를 붙인다. 외부 label은 기존 label을 덮지 않는다.
  external_labels = {
    environment = "prod",
    host        = "oci-prod",
  }

  endpoint {
    url = sys.env("GRAFANA_CLOUD_PROM_URL")

    basic_auth {
      username      = sys.env("GRAFANA_CLOUD_PROM_USER")
      // access policy token(metrics:write만). 값은 호스트 파일에만 있다.
      password_file = "/run/secrets/grafana-cloud-metrics-token"
    }
  }
}
