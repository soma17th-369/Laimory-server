// OCI prod host(단일 호스트: api·ai·nginx·mysql)의 경보용 지표를 Grafana Cloud(Free)로 보낸다.
// compose 서비스로 `laimory` 네트워크에 붙어 api·ai를 서비스 이름으로 찾는다(호스트 포트 publish 없음).
//
// 무료 한도(지표 10k active series) 안에 머물기 위해 경보 식이 쓰는 지표 이름만 내보낸다(아래 keep 규칙).
// 경보를 추가하면서 새 지표가 필요하면 keep 정규식에도 넣는다 — 넣지 않은 지표는 Cloud에 없다.
// 로그를 밖으로 보내지 않는다 — api ERROR 로그는 호스트에서 줄 수만 세어 counter로 내보낸다(개인정보 없음). trace 없음.

// ── 호스트: 메모리·디스크·OOM + textfile(MySQL 백업·Upstash 사용량 지표) ─────────────────
prometheus.exporter.unix "host" {
  set_collectors = ["meminfo", "filesystem", "vmstat", "textfile"]
  procfs_path    = "/host/proc"
  sysfs_path     = "/host/sys"
  rootfs_path    = "/host/root"

  filesystem {
    fs_types_exclude     = "^(autofs|binfmt_misc|bpf|cgroup2?|configfs|debugfs|devpts|devtmpfs|efivarfs|fusectl|hugetlbfs|iso9660|mqueue|nsfs|overlay|proc|procfs|pstore|ramfs|rpc_pipefs|securityfs|selinuxfs|squashfs|sysfs|tmpfs|tracefs)$"
    mount_points_exclude = "^/(dev|proc|run|sys|var/lib/docker/.+)($|/)"
  }

  // 수집 스크립트(systemd timer)가 쓰는 디렉터리. 호스트 루트를 읽기 전용으로 마운트한 경로 아래에 있다.
  textfile {
    directory = "/host/root/var/lib/laimory/textfile"
  }
}

discovery.relabel "host" {
  targets = prometheus.exporter.unix.host.targets

  rule {
    target_label = "job"
    replacement  = "node"
  }
}

prometheus.scrape "host" {
  targets         = discovery.relabel.host.output
  scrape_interval = "60s"
  forward_to      = [prometheus.relabel.keep.receiver]
}

// ── api: Spring actuator(관리 포트 9090, 컨테이너 내부망에서만 열림) ─────────────────
// blue/green 중 한 색만 실행되므로 다른 색의 up=0은 정상이다. 아래 keep 규칙이 instance를 고정하므로
// color가 없으면 두 색이 같은 시계열이 된다.
prometheus.scrape "api" {
  targets = [
    {"__address__" = "api-blue:9090", "color" = "blue"},
    {"__address__" = "api-green:9090", "color" = "green"},
  ]
  job_name        = "spring_boot"
  metrics_path    = "/actuator/prometheus"
  scrape_interval = "60s"
  forward_to      = [prometheus.relabel.keep.receiver]
}

// ── ai: 지표 endpoint가 없어 /health 응답만 본다. nginx 내부 listener를 거쳐 활성 색을 따라간다 ──
prometheus.exporter.blackbox "ai" {
  config = "{ modules: { http_2xx: { prober: http, timeout: 5s } } }"

  target {
    name    = "ai_health"
    address = "http://nginx:8089/health"
    module  = "http_2xx"
  }
}

discovery.relabel "ai" {
  targets = prometheus.exporter.blackbox.ai.targets

  rule {
    target_label = "job"
    replacement  = "ai_health"
  }
}

prometheus.scrape "ai" {
  targets         = discovery.relabel.ai.output
  scrape_interval = "60s"
  forward_to      = [prometheus.relabel.keep.receiver]
}

// ── api ERROR 로그 수: docker json-file 로그를 읽어 줄 수만 센다(로그 자체는 어디로도 보내지 않는다) ──
// 호스트 루트를 읽기 전용으로 마운트한 경로에서 모든 컨테이너 로그를 읽고, Spring 앱(service=laimory)의
// level=ERROR 줄만 counter를 올린다. 처음 기동·재기동 때 과거 줄을 다시 세지 않게 끝에서부터 읽는다.
local.file_match "docker_logs" {
  path_targets = [{"__path__" = "/host/root/var/lib/docker/containers/*/*-json.log"}]
}

loki.source.file "docker_logs" {
  targets       = local.file_match.docker_logs.targets
  forward_to    = [loki.process.app_errors.receiver]
  tail_from_end = true
}

loki.process "app_errors" {
  forward_to = []

  stage.docker {}

  stage.json {
    expressions = { level = "level", service = "service" }
  }

  stage.template {
    source   = "is_app_error"
    template = "{{ if and .level .service }}{{ if and (eq .level \"ERROR\") (eq .service \"laimory\") }}1{{ end }}{{ end }}"
  }

  // 파일 경로(컨테이너 ID)·stream별로 counter가 갈리면 아래에서 label을 지울 때 두 색의 시계열이 겹친다.
  stage.label_drop {
    values = ["filename", "stream"]
  }

  stage.metrics {
    metric.counter {
      name        = "laimory_app_error_logs_total"
      description = "Spring app (service=laimory) log lines at level ERROR on the OCI host."
      source      = "is_app_error"
      value       = "1"
      action      = "inc"
    }
  }
}

// 위 counter는 Alloy 자신의 지표로 나온다(loki_process_custom_ 접두사).
prometheus.exporter.self "alloy" {}

prometheus.scrape "alloy" {
  targets         = prometheus.exporter.self.alloy.targets
  job_name        = "alloy"
  scrape_interval = "60s"
  forward_to      = [prometheus.relabel.keep.receiver]
}

// ── 내보낼 지표 고르기 ─────────────────────────────────────────────────────────────
prometheus.relabel "keep" {
  forward_to = [prometheus.remote_write.grafana_cloud.receiver]

  rule {
    source_labels = ["__name__"]
    regex         = "up|probe_success|laimory_oci_.+|laimory_upstash_.+|laimory_credit_history_(charged_stale|recent_ai_failed)|laimory_inquiry_unanswered|loki_process_custom_laimory_app_error_logs_total|node_memory_(MemAvailable|MemTotal)_bytes|node_filesystem_(avail|size)_bytes|node_vmstat_oom_kill|http_server_requests_seconds_(count|bucket)|jvm_memory_(used|max)_bytes|hikaricp_connections_(active|max|pending)"
    action        = "keep"
  }

  // ERROR 로그 counter의 파일 경로(컨테이너 ID 포함)·stream label을 지운다 — api 재생성마다 series가 늘지 않게.
  rule {
    action = "labeldrop"
    regex  = "filename|stream"
  }

  // label에 호스트 이름·IP·컨테이너 주소가 남지 않게 instance를 고정한다.
  rule {
    target_label = "instance"
    replacement  = "oci-prod"
  }
}

prometheus.remote_write "grafana_cloud" {
  // api 지표는 앱이 이미 environment="prod"를 붙인다. 외부 label은 기존 label을 덮지 않는다.
  external_labels = {
    environment = "prod",
    host        = "oci-prod",
  }

  endpoint {
    url = sys.env("GRAFANA_CLOUD_PROM_URL")

    basic_auth {
      username      = sys.env("GRAFANA_CLOUD_PROM_USER")
      // access policy token(metrics:write만). 값은 호스트 파일에만 있다.
      password_file = "/run/secrets/grafana-cloud-metrics-token"
    }
  }
}
