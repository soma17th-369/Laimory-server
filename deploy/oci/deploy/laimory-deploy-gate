#!/usr/bin/env bash
# deploy 계정의 SSH forced command. authorized_keys가 키마다 서비스(api|ai)를 고정해 부른다.
# 클라이언트가 보낸 명령은 `deploy <sha> <digest>` 하나만 받아들이고 그 외는 실행하지 않는다.
set -uo pipefail
SERVICE="${1:-}"
case "$SERVICE" in api|ai) ;; *) echo "invalid service" >&2; exit 2 ;; esac
if [[ "${SSH_ORIGINAL_COMMAND:-}" =~ ^deploy\ ([0-9a-f]{40})\ (sha256:[0-9a-f]{64})$ ]]; then
  exec sudo -n /usr/local/sbin/laimory-deploy "$SERVICE" "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}"
fi
echo "rejected: expected 'deploy <sha> <digest>'" >&2
exit 2
