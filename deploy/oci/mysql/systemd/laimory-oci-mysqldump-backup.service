[Unit]
Description=Laimory OCI MySQL logical dump backup to R2
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
TimeoutStartSec=1800
ExecStart=/usr/local/sbin/backup-oci-mysql-dump
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
StateDirectory=laimory
