[Unit]
Description=Laimory prod MySQL logical dump backup
Wants=network-online.target
After=network-online.target mysql.service node_exporter.service

[Service]
Type=oneshot
User=root
TimeoutStartSec=1800
ExecStart=/usr/local/sbin/backup-laimory-mysql-dump
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/node_exporter/textfile_collector /var/lib/laimory
