[Unit]
Description=Laimory Upstash monthly usage metric collector
Wants=network-online.target
After=network-online.target node_exporter.service

[Service]
Type=oneshot
User=root
EnvironmentFile=/opt/laimory-monitoring/.env
ExecCondition=/usr/bin/test -s /opt/laimory-monitoring/secrets/upstash_api_credentials
ExecStart=/opt/laimory-monitoring/scripts/collect-upstash-metrics.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/opt/laimory-monitoring/secrets/upstash_api_credentials
ReadWritePaths=/var/lib/node_exporter/textfile_collector
