[Unit]
Description=Laimory prod MySQL binlog spool upload to S3
Wants=network-online.target
After=network-online.target node_exporter.service

[Service]
Type=oneshot
User=root
TimeoutStartSec=300
ExecStart=/opt/laimory-monitoring/scripts/upload-binlog.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/node_exporter/textfile_collector
StateDirectory=laimory
