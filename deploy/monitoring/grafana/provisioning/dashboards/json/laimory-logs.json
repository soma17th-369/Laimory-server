    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Elasticsearch cluster health의 현재 green/yellow/red 상태입니다.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": [
