#!/bin/bash
# WAS 부트스트랩: docker + aws cli + 앱 .env 시드. 앱 컨테이너는 deploy.yml(SSM)이 배포한다.
set -euxo pipefail
export DEBIAN_FRONTEND=noninteractive

# 스왑 2GB: 스왑 없는 1~2GB 박스는 메모리 스파이크(apt-daily 등) 때 OOM 킬 대신 페이지 회수
# 라이브락으로 박스 전체(SSM 포함)가 동결된다. 기존 박스는 SSM 수동 적용(README runbook).
fallocate -l 2G /swapfile
chmod 600 /swapfile
mkswap /swapfile
swapon /swapfile
echo '/swapfile none swap sw 0 0' >> /etc/fstab

apt-get update -y
apt-get install -y ca-certificates curl gnupg jq unzip

# AWS CLI v2 (ECR 로그인 등)
curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o /tmp/awscliv2.zip
unzip -q /tmp/awscliv2.zip -d /tmp
/tmp/aws/install

# Docker Engine (공식 apt 저장소)
install -m 0755 -d /etc/apt/keyrings
curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
chmod a+r /etc/apt/keyrings/docker.asc
echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu $(. /etc/os-release && echo "$VERSION_CODENAME") stable" > /etc/apt/sources.list.d/docker.list
apt-get update -y
apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
systemctl enable --now docker
usermod -aG docker ubuntu

# nginx 리버스 프록시: 외부 80/443 -> 앱 8080(--network host). 443은 아래 certbot이 구성한다.
apt-get install -y nginx

# access log에서 query string 제거: OAuth 핸드오프(/auth/app?code=)·IdP 콜백(?code=)이 로그에 남지 않게.
# log_format 은 http 컨텍스트 전용 지시자라 server 블록에 못 두고 conf.d(http 레벨 include)에 둔다.
cat > /etc/nginx/conf.d/log_format_noquery.conf <<'NGINXLOG'
log_format noquery '$remote_addr - $remote_user [$time_local] "$request_method $uri $server_protocol" $status $body_bytes_sent "$http_user_agent"';
NGINXLOG

# heredoc 의 'NGINX' quote 는 bash 확장만 막는다 — server_name 의 api_domain 은 그 전에
# terraform templatefile 이 치환하고, nginx 변수($host 등)는 bare $ 라 templatefile 이 건드리지 않는다.
# 환경별 추가 location 을 include 로 분리한다(dev의 Kibana /kibana 및 allowlist가 있을 때만 Grafana
# /grafana 프록시). prod 은 빈 파일(no-op).
# certbot --nginx 가 이 server 블록을 443 으로 승격할 때 include 지시자도 그대로 옮겨가므로,
# 아래 env=="dev" 블록이 스니펫을 채우고 reload 하면 /kibana 가 443(HTTPS)에서 바로 동작한다.
install -d /etc/nginx/snippets
touch /etc/nginx/snippets/laimory-extra.conf

cat > /etc/nginx/sites-available/laimory <<'NGINX'
server {
    listen 80 default_server;
    server_name ${api_domain};
    client_max_body_size 20m;
    access_log /var/log/nginx/access.log noquery;
    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    include /etc/nginx/snippets/laimory-extra.conf;
}
NGINX
ln -sf /etc/nginx/sites-available/laimory /etc/nginx/sites-enabled/laimory
rm -f /etc/nginx/sites-enabled/default
systemctl enable nginx
systemctl restart nginx

# TLS: certbot(Let's Encrypt). --nginx 가 443 server 블록 생성+인증서 장착+80→443 리다이렉트까지 구성하고
# certbot.timer 로 자동 갱신된다. 발급은 DNS(A 레코드)가 이 박스 EIP를 가리켜야 성공하는데, 최초 부팅
# 시점엔 NS 위임 전일 수 있으므로 실패해도 부트를 막지 않는다(|| true) — 재시도는 README runbook.
# 80→443 리다이렉트여도 배포 헬스체크·AI 콜백은 localhost:8080 직결이라 무영향.
apt-get install -y certbot python3-certbot-nginx
certbot --nginx -d ${api_domain} --non-interactive --agree-tos -m ${certbot_email} --redirect || true

# 앱 .env (deploy.yml 이 --env-file 로 사용). REDIS_KEY_PREFIX 는 배포 시 -e 로 주입.
mkdir -p /home/ubuntu/app
cat > /home/ubuntu/app/.env <<'ENVEOF'
AWS_REGION=${region}
DB_HOST=${db_host}
DB_USERNAME=${db_username}
DB_PASSWORD=${db_password}
REDIS_HOST=${redis_host}
REDIS_PORT=6379
REDIS_USERNAME=${redis_username}
REDIS_PASSWORD=${redis_password}
REDIS_SSL=${redis_ssl}
PHOTO_S3_BUCKET=${photo_bucket}
PHOTO_CDN_DOMAIN=${photo_cdn_domain}
ENVEOF
chown -R ubuntu:ubuntu /home/ubuntu/app
chmod 600 /home/ubuntu/app/.env

# FCM(firebase 모드)용 secrets 디렉터리 골격만 생성 — credential 값은 Terraform 변수/state/user_data에
# 넣지 않는다. service-account JSON(firebase-service-account.json)은 README runbook의 SSM 절차로 수동
# 배치하고, deploy.yml pre-flight가 APP_PUSH_MODE=firebase일 때 파일 존재를 검사한다(noop 기본이면 빈 채로 무방).
install -d -m 700 -o ubuntu -g ubuntu /home/ubuntu/app/secrets

%{ if env == "dev" ~}
# ---- dev DB 읽기전용 터널 bastion 설정 ----
# 이 박스를 SSH 포트포워딩 전용 관문으로 쓴다. dbviewer(nologin) 유저가 dev-mysql:3306 으로만
# 터널하도록 authorized_keys 옵션(restrict + permitopen)으로 잠근다. WAS 는 평소 SSM 전용이라
# sshd 가 꺼져 있으므로 켠다. 22번 개방은 terraform 이 dev WAS 에만 붙인 별도 bastion SG 로 제한.
systemctl enable --now ssh
id dbviewer >/dev/null 2>&1 || useradd -m -s /usr/sbin/nologin dbviewer
install -d -m 700 -o dbviewer -g dbviewer /home/dbviewer/.ssh
cat > /home/dbviewer/.ssh/authorized_keys <<'AUTHKEYS'
restrict,port-forwarding,permitopen="${db_host}:3306" ${bastion_ssh_public_key}
AUTHKEYS
chown dbviewer:dbviewer /home/dbviewer/.ssh/authorized_keys
chmod 600 /home/dbviewer/.ssh/authorized_keys
%{ endif ~}

%{ if env == "dev" ~}
# ---- dev 전용: ELK 로그 수집 + 관측 UI 리버스 프록시 ----
# dev ELK 박스(사설 ${elk_private_ip})가 ES/Kibana 를 호스팅한다. 이 박스는 로그를 생산하므로
# Filebeat 로 앱 컨테이너 stdout(JSON)을 ES 로 직송하고, Kibana UI 는 기존 nginx TLS 로 프록시한다.
# prod-was 엔 미주입(dev ELK IP 하드코딩·잘못된 프록시 방지).

# (1) Filebeat 컨테이너: --user root 필수(컨테이너 로그가 root:root 0600). 비번은 -e 로만 주입(파일 X).
aws s3 cp "s3://${backup_bucket}/bootstrap/elk/filebeat.yml" /home/ubuntu/filebeat.yml --region ${region}
chown ubuntu:ubuntu /home/ubuntu/filebeat.yml
docker rm -f filebeat >/dev/null 2>&1 || true
docker run -d --name filebeat --restart unless-stopped --network host --user root \
  -e FILEBEAT_PASSWORD='${filebeat_password}' \
  -v /home/ubuntu/filebeat.yml:/usr/share/filebeat/filebeat.yml:ro \
  -v /var/lib/docker/containers:/var/lib/docker/containers:ro \
  -v filebeat-data:/usr/share/filebeat/data \
  docker.elastic.co/beats/filebeat:${stack_version} filebeat -e --strict.perms=false

# (2) Kibana 리버스 프록시(/kibana → ELK 5601). 위 include 로 443 server 블록에 로드된다.
#     Kibana 는 SERVER_BASEPATH=/kibana + rewriteBasePath 라 proxy_pass 에 trailing slash 를 두지 않는다.
cat > /etc/nginx/snippets/laimory-extra.conf <<'KIBANA'
location = /kibana { return 302 /kibana/; }
location /kibana/ {
    proxy_pass http://${elk_private_ip}:5601;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
%{ if length(kibana_allowed_cidrs) > 0 ~}
%{ for c in kibana_allowed_cidrs ~}    allow ${c};
%{ endfor ~}    deny all;
%{ endif ~}
}
KIBANA
nginx -t && systemctl reload nginx

# Grafana proxy는 별도 include로 관리해 기존 Kibana location을 덮어쓰지 않는다. 같은 스크립트를
# terraform/README.md의 live SSM runbook에서도 사용하므로 enable/disable, backup, nginx -t 계약이 같다.
cat > /usr/local/sbin/laimory-grafana-proxy <<'GRAFANA_PROXY_SCRIPT'
${grafana_proxy_script}
GRAFANA_PROXY_SCRIPT
chmod 0750 /usr/local/sbin/laimory-grafana-proxy

%{ if length(grafana_allowed_cidrs) > 0 ~}
/usr/local/sbin/laimory-grafana-proxy enable '${monitoring_private_ip}'%{ for c in grafana_allowed_cidrs ~} '${c}'%{ endfor ~}
%{ endif ~}

# node_exporter는 dev host의 private interface:9100에만 bind한다.
aws s3 cp "s3://${backup_bucket}/bootstrap/monitoring/node-exporter/install.sh" \
  /usr/local/sbin/install-laimory-node-exporter --region ${region} --only-show-errors
chmod 0750 /usr/local/sbin/install-laimory-node-exporter
/usr/local/sbin/install-laimory-node-exporter ${node_exporter_version} ${node_exporter_linux_amd64_sha256}

# Filebeat HTTP stats는 loopback-only이며, 1분마다 node_exporter textfile로 변환한다.
aws s3 cp "s3://${backup_bucket}/bootstrap/monitoring/scripts/collect-filebeat-metrics.sh" \
  /usr/local/sbin/collect-laimory-filebeat-metrics --region ${region} --only-show-errors
aws s3 cp "s3://${backup_bucket}/bootstrap/monitoring/systemd/laimory-filebeat-metrics.service" \
  /etc/systemd/system/laimory-filebeat-metrics.service --region ${region} --only-show-errors
aws s3 cp "s3://${backup_bucket}/bootstrap/monitoring/systemd/laimory-filebeat-metrics.timer" \
  /etc/systemd/system/laimory-filebeat-metrics.timer --region ${region} --only-show-errors
chmod 0750 /usr/local/sbin/collect-laimory-filebeat-metrics
chmod 0644 /etc/systemd/system/laimory-filebeat-metrics.service \
  /etc/systemd/system/laimory-filebeat-metrics.timer
systemctl daemon-reload
systemctl enable --now laimory-filebeat-metrics.timer
%{ endif ~}
