#!/bin/bash
# WAS 부트스트랩: docker + aws cli + 앱 .env 시드. 앱 컨테이너는 deploy.yml(SSM)이 배포한다.
set -euxo pipefail
export DEBIAN_FRONTEND=noninteractive

apt-get update -y
apt-get install -y ca-certificates curl gnupg unzip

# AWS CLI v2 (ECR 로그인 등)
curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o /tmp/awscliv2.zip
unzip -q /tmp/awscliv2.zip -d /tmp
/tmp/aws/install

# Docker Engine (공식 apt 저장소)
install -m 0755 -d /etc/apt/keyrings
curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
chmod a+r /etc/apt/keyrings/docker.asc
echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu $(. /etc/os-release && echo "$VERSION_CODENAME") stable" > /etc/apt/sources.list.d/docker.list
apt-get update -y
apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
systemctl enable --now docker
usermod -aG docker ubuntu

# nginx 리버스 프록시: 외부 80/443 -> 앱 8080(--network host). 443은 아래 certbot이 구성한다.
apt-get install -y nginx

# access log에서 query string 제거: OAuth 핸드오프(/auth/app?code=)·IdP 콜백(?code=)이 로그에 남지 않게.
# log_format 은 http 컨텍스트 전용 지시자라 server 블록에 못 두고 conf.d(http 레벨 include)에 둔다.
cat > /etc/nginx/conf.d/log_format_noquery.conf <<'NGINXLOG'
log_format noquery '$remote_addr - $remote_user [$time_local] "$request_method $uri $server_protocol" $status $body_bytes_sent "$http_user_agent"';
NGINXLOG

# heredoc 의 'NGINX' quote 는 bash 확장만 막는다 — server_name 의 api_domain 은 그 전에
# terraform templatefile 이 치환하고, nginx 변수($host 등)는 bare $ 라 templatefile 이 건드리지 않는다.
cat > /etc/nginx/sites-available/laimory <<'NGINX'
server {
    listen 80 default_server;
    server_name ${api_domain};
    client_max_body_size 20m;
    access_log /var/log/nginx/access.log noquery;
    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
NGINX
ln -sf /etc/nginx/sites-available/laimory /etc/nginx/sites-enabled/laimory
rm -f /etc/nginx/sites-enabled/default
systemctl enable nginx
systemctl restart nginx

# TLS: certbot(Let's Encrypt). --nginx 가 443 server 블록 생성+인증서 장착+80→443 리다이렉트까지 구성하고
# certbot.timer 로 자동 갱신된다. 발급은 DNS(A 레코드)가 이 박스 EIP를 가리켜야 성공하는데, 최초 부팅
# 시점엔 NS 위임 전일 수 있으므로 실패해도 부트를 막지 않는다(|| true) — 재시도는 README runbook.
# 80→443 리다이렉트여도 배포 헬스체크·AI 콜백은 localhost:8080 직결이라 무영향.
apt-get install -y certbot python3-certbot-nginx
certbot --nginx -d ${api_domain} --non-interactive --agree-tos -m ${certbot_email} --redirect || true

# 앱 .env (deploy.yml 이 --env-file 로 사용). REDIS_KEY_PREFIX 는 배포 시 -e 로 주입.
mkdir -p /home/ubuntu/app
cat > /home/ubuntu/app/.env <<'ENVEOF'
AWS_REGION=${region}
DB_HOST=${db_host}
DB_USERNAME=${db_username}
DB_PASSWORD=${db_password}
REDIS_HOST=${redis_host}
REDIS_PORT=6379
REDIS_USERNAME=${redis_username}
REDIS_PASSWORD=${redis_password}
REDIS_SSL=${redis_ssl}
PHOTO_S3_BUCKET=${photo_bucket}
PHOTO_CDN_DOMAIN=${photo_cdn_domain}
ENVEOF
chown -R ubuntu:ubuntu /home/ubuntu/app
chmod 600 /home/ubuntu/app/.env
