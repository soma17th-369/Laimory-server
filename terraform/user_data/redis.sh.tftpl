#!/bin/bash
# Redis 부트스트랩: redis7 + ACL 유저. TLS 미사용 — 프라이빗 서브넷 + SG(6379는 WAS만)로 격리.
# 실사용자 데이터 도입 시엔 관리형 Redis(ElastiCache/MemoryDB) in-transit 암호화로 전환 권장.
set -euxo pipefail
export DEBIAN_FRONTEND=noninteractive

apt-get update -y
apt-get install -y redis-server curl unzip

# AWS CLI v2 (secretless monitoring bootstrap object를 exact key로 pull).
curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o /tmp/awscliv2.zip
unzip -q /tmp/awscliv2.zip -d /tmp
/tmp/aws/install

# ACL 유저 (default off, 앱 유저만 허용)
cat > /etc/redis/users.acl <<'ACL'
user default off
user ${redis_username} on >${redis_password} ~* &* +@all
user ${redis_exporter_username} off resetkeys resetchannels -@all +info +ping +client|setname
ACL
chown redis:redis /etc/redis/users.acl
chmod 640 /etc/redis/users.acl

# 원격 접속 허용(평문 6379; 인바운드는 SG로 WAS SG만) + ACL
cat >> /etc/redis/redis.conf <<'CONF'

# --- terraform user_data ---
bind 0.0.0.0
protected-mode no
aclfile /etc/redis/users.acl
CONF

systemctl enable redis-server
systemctl restart redis-server

aws s3 cp "s3://${backup_bucket}/bootstrap/monitoring/node-exporter/install.sh" \
  /usr/local/sbin/install-laimory-node-exporter --region ${region} --only-show-errors
aws s3 cp "s3://${backup_bucket}/bootstrap/monitoring/scripts/configure-redis-exporter-user.sh" \
  /usr/local/sbin/configure-laimory-redis-exporter-user --region ${region} --only-show-errors
chmod 0750 /usr/local/sbin/install-laimory-node-exporter
chmod 0750 /usr/local/sbin/configure-laimory-redis-exporter-user
/usr/local/sbin/install-laimory-node-exporter ${node_exporter_version} ${node_exporter_linux_amd64_sha256}
