# 이 파일을 복사해 secrets.auto.tfvars 로 만들고 값을 채운다.
#   cp secrets.auto.tfvars.example secrets.auto.tfvars
# secrets.auto.tfvars 는 .gitignore 대상이라 커밋되지 않는다.
# 데이터 폐기 가능한 단계이므로 새 비밀번호를 자유롭게 생성해도 된다.
# 단, user_data(SQL·Redis ACL) 파싱 안전을 위해 아래 문자셋만 사용(variables.tf validation 강제):
#   영숫자 + ! # % ^ * _ + = : . , ~ @ -   (따옴표·공백·$·백슬래시 등 금지, 8~128자)

db_app_password      = "CHANGE_ME_app_db_password"
db_readonly_password = "CHANGE_ME_readonly_password"
redis_app_password   = "CHANGE_ME_redis_password"

# ELK 로그 수집(dev) — Elasticsearch 계정 비밀번호 3종(같은 문자셋 규칙).
#   elastic  : ES superuser. 첫 부팅 시 볼륨에 각인되니 로테이션 시 change-password API 필요.
#   kibana   : Kibana↔ES 연결(kibana_system). setup 이 매 up 마다 재적용.
#   filebeat : WAS Filebeat 송신(filebeat_writer). setup 이 매 up 마다 재적용.
elk_elastic_password  = "CHANGE_ME_es_elastic_password"
elk_kibana_password   = "CHANGE_ME_es_kibana_password"
elk_filebeat_password = "CHANGE_ME_es_filebeat_password"

# Let's Encrypt(certbot) 만료 알림 이메일 — 비밀은 아니지만 개인값이라 여기서 주입.
certbot_email = "CHANGE_ME@example.com"
