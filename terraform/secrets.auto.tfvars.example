# 이 파일을 복사해 secrets.auto.tfvars 로 만들고 값을 채운다.
#   cp secrets.auto.tfvars.example secrets.auto.tfvars
# secrets.auto.tfvars 는 .gitignore 대상이라 커밋되지 않는다.
# 데이터 폐기 가능한 단계이므로 새 비밀번호를 자유롭게 생성해도 된다.
# 단, user_data(SQL·Redis ACL) 파싱 안전을 위해 아래 문자셋만 사용(variables.tf validation 강제):
#   영숫자 + ! # % ^ * _ + = : . , ~ @ -   (따옴표·공백·$·백슬래시 등 금지, 8~128자)

db_app_password    = "CHANGE_ME_app_db_password"
redis_app_password = "CHANGE_ME_redis_password"
