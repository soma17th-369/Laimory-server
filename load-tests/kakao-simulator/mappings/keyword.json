      "x": {
        "matches": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$"
      },
      "y": {
        "matches": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$"
      },
      "radius": {
        "equalTo": "50"
      },
      "sort": {
