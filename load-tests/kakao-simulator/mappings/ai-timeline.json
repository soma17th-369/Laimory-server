{
  "id": "02570000-0000-4000-8000-000000000003",
  "name": "ai-timeline-dispatch",
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/v1/timeline",
    "bodyPatterns": [
      {
        "matchesJsonPath": "$.taskId"
      },
      {
        "matchesJsonPath": "$.taskToken"
      },
      {
        "matchesJsonPath": "$.dailyRecordId"
      },
      {
        "matchesJsonPath": "$.window.startAt"
      }
    ]
  },
  "response": {
    "status": 202,
    "headers": {
      "Content-Type": "application/json"
    },
    "body": "{\"taskId\":\"{{jsonPath request.body '$.taskId'}}\",\"status\":\"PROCESSING\"}",
    "transformers": [
      "response-template"
    ],
    "fixedDelayMilliseconds": 50
  },
  "serveEventListeners": [
    {
      "name": "webhook",
      "parameters": {
        "method": "POST",
        "url": "http://10.0.4.78:8080/s/api/v1/timeline/drafts/{{jsonPath originalRequest.body '$.taskId'}}/callback",
        "headers": {
          "Content-Type": "application/json",
          "Task-Token": "{{jsonPath originalRequest.body '$.taskToken'}}"
        },
        "body": "{\"status\":\"FAILED\",\"errorCode\":-1008,\"error\":\"kakao-simulator fake AI\"}",
        "delay": {
          "type": "fixed",
          "milliseconds": 60000
        }
      }
    }
  ]
}
